                        "disclosable": false
                      },
                      {
                        "key": "driving_privileges",
                        "label": "Tipo y restricciones",
                        "type": "driving_privileges",
                        "required": true,
                        "disclosable": false
                      },
                      {
                        "key": "portrait",
                        "label": "Foto",
