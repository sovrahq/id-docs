{
  "openapi": "3.1.0",
  "info": {
    "title": "Sovra ID API",
    "version": "v1",
    "description": "API servidor-a-servidor de Sovra ID. Las zonas `issuer` y `verifier` se autentican con una API key de workspace (`Authorization: Bearer sovra_sk_...`).\n\nEsta referencia se generó a partir de las colecciones de Postman del repositorio `sovrahq/id-docs`. La especificación completa se publica en `GET {baseUrl}/openapi/api`."
  },
  "servers": [
    {
      "url": "https://test-api-sovra.flagonsa.com",
      "description": "Test"
    },
    {
      "url": "https://api.sovra.io",
      "description": "Producción"
    }
  ],
  "tags": [
    {
      "name": "Credenciales",
      "description": "Ciclo de vida de emisión de credenciales, acotado al workspace de la API key."
    },
    {
      "name": "Esquemas",
      "description": "Creación y consulta de esquemas de credenciales."
    },
    {
      "name": "Verificaciones",
      "description": "Sesiones de verificación OID4VP, acotadas al workspace de la API key."
    },
    {
      "name": "Documentos firmados",
      "description": "Emisión, visibilidad, listado y lectura pública de documentos firmados."
    },
    {
      "name": "Listas de estado",
      "description": "Listas de estado de revocación y suspensión. No requieren autenticación."
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/api/v1/issuer/credential-offer": {
      "post": {
        "operationId": "createCredentialOffer",
        "summary": "Crear oferta de credencial",
        "description": "Crea una oferta OID4VCI pre-autorizada.\n\n`schema_id` es el slug del esquema (no su UUID); se usa siempre su última versión. `claims` se preasocian a la oferta y se copian en la credencial cuando el holder la canjea.\n\nLa respuesta trae `credential_id` (identificador estable de todo el ciclo de vida), `offer_uri` (para el QR), `expires_at` (24 h) y `credential` (vista previa **sin firmar**).\n\nEl SD-JWT firmado llega después, en el webhook `credential.issued`.\n\nRate limit: 120 req/min por API key.",
        "tags": [
          "Credenciales"
        ],
        "responses": {
          "200": {
            "description": "Respuesta exitosa. La colección de Postman de origen no incluye el cuerpo de la respuesta; ver la guía de referencia."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "schema_id": {
                    "type": "string"
                  },
                  "claims": {
                    "type": "object",
                    "properties": {
                      "full_name": {
                        "type": "string"
                      },
                      "age_over_18": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              },
              "examples": {
                "ejemplo1": {
                  "summary": "Crear oferta de credencial",
                  "value": {
                    "schema_id": "<schemaId>",
                    "claims": {
                      "full_name": "Ada Lovelace",
                      "age_over_18": true
                    }
                  }
                },
                "ejemplo2": {
                  "summary": "Crear oferta (24 claims)",
                  "value": {
                    "schema_id": "driving_licence_v2",
                    "valid_until": "2030-10-22T23:59:59Z",
                    "claims": {
                      "given_name": "Sofía",
                      "family_name": "Demo",
                      "second_family_name": "Lambda",
                      "birth_date": "1990-01-01",
                      "document_number": "NL-2026-0001",
                      "issue_date": "2026-10-22",
                      "expiry_date": "2030-10-22",
                      "driving_privileges": [
                        {
                          "vehicle_category_code": "B",
                          "issue_date": "2026-10-22",
                          "expiry_date": "2030-10-22",
                          "codes": [
                            {
                              "code": "01",
                              "sign": "<=",
                              "value": "70"
                            }
                          ]
                        }
                      ],
                      "portrait": "/9j/4AAQSkZJRgABAQAAAQABAAD...",
                      "signature_usual_mark": "iVBORw0KGgoAAAANSUhEUgAAA...",
                      "issuing_authority": "Secretaría de Movilidad y Planeación Urbana",
                      "street": "Av. Constitución",
                      "exterior_number": "1234",
                      "interior_number": "5B",
                      "neighborhood": "Centro",
                      "resident_city": "Monterrey",
                      "resident_postal_code": "64000",
                      "issuing_country": "MX",
                      "age_over_18": true,
                      "curp": "DELS900101MNLXXX01",
                      "organ_donor": true,
                      "blood_type": "O+",
                      "allergies": "Penicilina",
                      "emergency_phone": "8181234567"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/issuer/credentials": {
      "get": {
        "operationId": "listCredentials",
        "summary": "Listar credenciales emitidas",
        "description": "Todas las credenciales efectivamente emitidas por el workspace. Las ofertas pendientes no aparecen acá; se consultan de a una por su `credential_id`.",
        "tags": [
          "Credenciales"
        ],
        "responses": {
          "200": {
            "description": "Respuesta exitosa. La colección de Postman de origen no incluye el cuerpo de la respuesta; ver la guía de referencia."
          }
        }
      }
    },
    "/api/v1/issuer/credentials/{credentialId}": {
      "get": {
        "operationId": "getCredential",
        "summary": "Consultar una credencial",
        "description": "Metadatos de una credencial. El mismo id cubre todo el ciclo de vida: mientras el holder no la canjeó, `status` es `pending` (o `expired` si venció la ventana de la oferta) con `holder_did` e `issued_at` en null; después de la emisión, `status` refleja el estado real (`issued`, `suspended`, `revoked`).\n\nEl SD-JWT firmado **no** se devuelve acá.",
        "tags": [
          "Credenciales"
        ],
        "parameters": [
          {
            "name": "credentialId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Respuesta exitosa. La colección de Postman de origen no incluye el cuerpo de la respuesta; ver la guía de referencia."
          }
        }
      }
    },
    "/api/v1/issuer/credentials/{credentialId}/status/revoked": {
      "put": {
        "operationId": "revokeCredential",
        "summary": "Revocar credencial",
        "description": "Revocación permanente. El bit correspondiente se marca on-chain y dispara el webhook `credential.revoked`.\n\nNo es idempotente: revocar algo ya revocado devuelve 422 `invalid_status_transition`.",
        "tags": [
          "Credenciales"
        ],
        "parameters": [
          {
            "name": "credentialId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Respuesta exitosa. La colección de Postman de origen no incluye el cuerpo de la respuesta; ver la guía de referencia."
          }
        }
      }
    },
    "/api/v1/issuer/credentials/{credentialId}/status/suspended": {
      "put": {
        "operationId": "suspendCredential",
        "summary": "Suspender credencial",
        "description": "Suspensión reversible. Solo se permite desde `issued`. Dispara `credential.suspended`.",
        "tags": [
          "Credenciales"
        ],
        "parameters": [
          {
            "name": "credentialId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Respuesta exitosa. La colección de Postman de origen no incluye el cuerpo de la respuesta; ver la guía de referencia."
          }
        }
      }
    },
    "/api/v1/issuer/credentials/{credentialId}/status/issued": {
      "put": {
        "operationId": "reactivateCredential",
        "summary": "Reactivar credencial suspendida",
        "description": "Devuelve a `issued` una credencial suspendida. Solo se permite desde `suspended`. Dispara `credential.unsuspended`.",
        "tags": [
          "Credenciales"
        ],
        "parameters": [
          {
            "name": "credentialId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Respuesta exitosa. La colección de Postman de origen no incluye el cuerpo de la respuesta; ver la guía de referencia."
          }
        }
      }
    },
    "/api/v1/verifier/verifications": {
      "post": {
        "operationId": "createVerification",
        "summary": "Crear sesión de verificación",
        "description": "Inicia una sesión de verificación OID4VP. `dcql_query` sigue la especificación DCQL de OID4VP.\n\nTres reglas que evitan casi todos los fallos:\n1. Cada `path` debe coincidir carácter por carácter con el `key` del esquema.\n2. Todos los claims pedidos son obligatorios: si el holder omite uno, falla toda la presentación.\n3. `id` es una etiqueta libre tuya, devuelta tal cual en el resultado; no filtra por tipo de credencial.\n\nLa respuesta trae `session_id`, `authorization_request_uri` (autocontenida) y `authorization_request_uri_ref` (corta, para DCQL grandes). La sesión vive 10 minutos.",
        "tags": [
          "Verificaciones"
        ],
        "responses": {
          "200": {
            "description": "Respuesta exitosa. La colección de Postman de origen no incluye el cuerpo de la respuesta; ver la guía de referencia."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "dcql_query": {
                    "type": "object",
                    "properties": {
                      "credentials": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "format": {
                              "type": "string"
                            },
                            "claims": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "path": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "examples": {
                "ejemplo1": {
                  "summary": "Crear sesión de verificación",
                  "value": {
                    "dcql_query": {
                      "credentials": [
                        {
                          "id": "identidad",
                          "format": "vc+sd-jwt",
                          "claims": [
                            {
                              "path": [
                                "email"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                "ejemplo2": {
                  "summary": "Control de tránsito (licencia completa)",
                  "value": {
                    "dcql_query": {
                      "credentials": [
                        {
                          "id": "licencia",
                          "format": "mso_mdoc",
                          "meta": {
                            "doctype_value": "io.sovra.0x5de0df12cce712ddaaa23feb359920ae4f3230d4.driving_licence_v2.1"
                          },
                          "claims": [
                            {
                              "path": [
                                "mx.gob.nl.icv.1",
                                "given_name"
                              ]
                            },
                            {
                              "path": [
                                "mx.gob.nl.icv.1",
                                "family_name"
                              ]
                            },
                            {
                              "path": [
                                "mx.gob.nl.icv.1",
                                "second_family_name"
                              ]
                            },
                            {
                              "path": [
                                "mx.gob.nl.icv.1",
                                "document_number"
                              ]
                            },
                            {
                              "path": [
                                "mx.gob.nl.icv.1",
                                "expiry_date"
                              ]
                            },
                            {
                              "path": [
                                "mx.gob.nl.icv.1",
                                "driving_privileges"
                              ]
                            },
                            {
                              "path": [
                                "mx.gob.nl.icv.1",
                                "portrait"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                "ejemplo3": {
                  "summary": "Verificación de edad (sin fecha de nacimiento)",
                  "value": {
                    "dcql_query": {
                      "credentials": [
                        {
                          "id": "edad",
                          "format": "mso_mdoc",
                          "meta": {
                            "doctype_value": "io.sovra.0x5de0df12cce712ddaaa23feb359920ae4f3230d4.driving_licence_v2.1"
                          },
                          "claims": [
                            {
                              "path": [
                                "mx.gob.nl.icv.1",
                                "age_over_18"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                "ejemplo4": {
                  "summary": "Urgencias médicas",
