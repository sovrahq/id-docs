    "/api/v1/status/{issuerDid}/revocation": {
      "get": {
        "operationId": "getRevocationStatusList",
        "summary": "Lista de estado (revocación)",
        "description": "La W3C Bitstring Status List firmada (VC-JWT, ES256) del emisor. Sin autenticación.\n\nResponde `application/jwt` con ETag y Cache-Control; mandá `If-None-Match` para recibir 304 cuando no cambió nada.\n\nEs la URL que las credenciales llevan embebida en su claim `credentialStatus`. La ruta es inmutable por diseño.",
        "tags": [
          "Listas de estado"
        ],
        "parameters": [
          {
            "name": "issuerDid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Respuesta exitosa. La colección de Postman de origen no incluye el cuerpo de la respuesta; ver la guía de referencia."
          }
        },
        "security": []
      }
    },
