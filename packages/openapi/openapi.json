                    "dcql_query": {
                      "credentials": [
                        {
                          "id": "urgencias",
                          "format": "mso_mdoc",
                          "meta": {
                            "doctype_value": "io.sovra.0x5de0df12cce712ddaaa23feb359920ae4f3230d4.driving_licence_v2.1"
                          },
                          "claims": [
                            {
                              "path": [
                                "mx.gob.nl.icv.1",
                                "blood_type"
