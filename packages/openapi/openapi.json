                        "required": true,
                        "disclosable": false
                      },
                      {
                        "key": "family_name",
                        "label": "Apellido paterno",
                        "type": "string",
                        "required": true,
                        "disclosable": false
                      },
                      {
                        "key": "second_family_name",
                        "label": "Apellido materno",
                        "type": "string",
                        "required": false,
                        "disclosable": false
                      },
                      {
                        "key": "birth_date",
                        "label": "Fecha de nacimiento",
                        "type": "date",
                        "required": true,
                        "disclosable": true
                      },
                      {
                        "key": "document_number",
                        "label": "Folio de licencia",
                        "type": "string",
                        "required": true,
                        "disclosable": false
                      },
                      {
                        "key": "issue_date",
                        "label": "Fecha de expedición",
                        "type": "date",
