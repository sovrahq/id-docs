    "/api/v1/issuer/documents": {
      "post": {
        "operationId": "issueDocument",
        "summary": "Emitir documento",
        "description": "Emite un documento con un schema previamente diseñado. Una sola llamada valida, firma y ancla: esperar hasta ~90 segundos.\n\n→ 201 si se creó exitosamente. **Conservar el `credential`**: ese string es el documento, autocontenido y verificable.\n\nErrores: 409 workspace_not_provisioned, 422 wrong_schema_kind / missing_claims / invalid_visibility, 503 chain_not_configured.",
        "tags": [
          "Documentos firmados"
        ],
        "responses": {
          "200": {
            "description": "Respuesta exitosa. La colección de Postman de origen no incluye el cuerpo de la respuesta; ver la guía de referencia."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "schema_id": {
                    "type": "string"
                  },
                  "claims": {
                    "type": "object",
                    "properties": {
                      "claim_key": {
                        "type": "string"
                      }
                    }
                  },
                  "visibility": {
                    "type": "string"
                  }
                }
              },
              "examples": {
                "ejemplo1": {
                  "summary": "Emitir documento",
                  "value": {
                    "schema_id": "<schema_id>",
                    "claims": {
                      "claim_key": "valor"
                    },
                    "visibility": "private"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listDocuments",
        "summary": "Listar documentos del workspace",
        "description": "Lista todos los documentos del workspace, del más reciente al más antiguo. Sin paginación. Cada entrada tiene la misma forma que la respuesta de emisión, `credential` y `claims` decodificados incluidos.",
        "tags": [
          "Documentos firmados"
        ],
        "responses": {
          "200": {
            "description": "Respuesta exitosa. La colección de Postman de origen no incluye el cuerpo de la respuesta; ver la guía de referencia."
          }
        }
      }
    },
    "/api/v1/issuer/documents/{documentId}/visibility/public": {
      "put": {
        "operationId": "makeDocumentPublic",
        "summary": "Cambiar visibilidad → public",
        "description": "Publica el documento. El valor viaja como último segmento del path, no en un body.\n\nEsto restringe los endpoints de la API, no el artefacto: una credencial ya entregada sigue siendo verificable por quien la tenga. La visibilidad no está cubierta por la firma.",
        "tags": [
          "Documentos firmados"
        ],
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Respuesta exitosa. La colección de Postman de origen no incluye el cuerpo de la respuesta; ver la guía de referencia."
          }
        }
      }
    },
    "/api/v1/issuer/documents/{documentId}/visibility/private": {
