# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000

# URL pública HTTPS de este servidor. En desarrollo, la que te da `ngrok http 3000`.
# Meta la usa para descargar el QR, y el ciudadano para abrir la wallet.
PUBLIC_BASE_URL=https://tu-subdominio.ngrok-free.app

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
# Meta → Business Settings → System Users → Generate token (permanente).
WHATSAPP_TOKEN=EAAG...
# Meta → WhatsApp → API Setup → "Phone number ID".
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Meta → App → Settings → Basic → "App secret". Firma los webhooks entrantes.
WHATSAPP_APP_SECRET=abc123...
# Lo inventás vos. Lo pegás igual en Meta → WhatsApp → Configuration → Verify token.
WHATSAPP_VERIFY_TOKEN=un-string-largo-y-aleatorio
GRAPH_API_VERSION=v21.0

# ─── Sovra ID ────────────────────────────────────────────────────────────────
# Sandbox: https://test-api-sovra.flagonsa.com · Producción: https://api.sovra.io
SOVRA_BASE_URL=https://test-api-sovra.flagonsa.com
SOVRA_API_KEY=sovra_sk_...
# Dashboard → Settings → Workspace → Webhook secret. Se muestra una sola vez.
SOVRA_WEBHOOK_SECRET=whsec_...

# Qué claims le pedimos a la credencial NO se configura acá: está fijo en
# src/credential.ts. Es la definición del trámite, no configuración de despliegue.

# ─── Caso 2 del diagrama: ciudadano sin credencial ───────────────────────────
# Adónde lo mandamos a sacarla. Se usa en el mensaje de fallo.
PORTAL_URL=https://portal.gob.ar/credencial
