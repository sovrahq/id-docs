<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/sovracred/db" VERSION="20261112" COMMENT="XMLDB file for local_sovracred"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_sovracred_issuance" COMMENT="Derecho de un estudiante a la credencial de un curso, y su oferta en Sovra">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="El estudiante que completó el curso"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="available" SEQUENCE="false" COMMENT="available, offered, issued, suspended, revoked"/>
        <FIELD NAME="verificationcode" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false" COMMENT="Código propio de esta credencial, viaja como claim"/>
        <FIELD NAME="timecompleted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="credentialid" TYPE="char" LENGTH="36" NOTNULL="false" SEQUENCE="false" COMMENT="credential_id de Sovra de la oferta vigente"/>
        <FIELD NAME="offeruri" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="openid-credential-offer://..."/>
        <FIELD NAME="offerexpires" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="holderdid" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timeissued" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="credexpires" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="expires_at de la credencial emitida, según Sovra; null si el esquema no vence"/>
        <FIELD NAME="statustime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Hora (reloj de Sovra) del último evento aplicado; descarta eventos desordenados"/>
        <FIELD NAME="timechecked" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Última consulta del estado a la API; ordena la reconciliación"/>
        <FIELD NAME="lasterror" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="usercourse" UNIQUE="true" FIELDS="userid, courseid"/>
        <INDEX NAME="credentialid" UNIQUE="false" FIELDS="credentialid"/>
        <INDEX NAME="statuschecked" UNIQUE="false" FIELDS="status, timechecked"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_sovracred_webhook" COMMENT="Entregas de webhook ya procesadas (idempotencia por id)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="eventid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="event" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timereceived" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="eventid" UNIQUE="true" FIELDS="eventid"/>
        <INDEX NAME="timereceived" UNIQUE="false" FIELDS="timereceived"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_sovracred_log" COMMENT="Registro de llamadas a la API de Sovra y de avisos del webhook. Sin claims ni cuerpos: sólo qué pasó">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="kind" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="api (Moodle → Sovra) o webhook (Sovra → Moodle)"/>
        <FIELD NAME="action" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Método y ruta de la API, o el tipo de evento"/>
        <FIELD NAME="httpstatus" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="api: lo que respondió Sovra (0 sin respuesta); webhook: lo que respondió Moodle"/>
        <FIELD NAME="result" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="api: ok o el código de error; webhook: applied, duplicate, badsignature…"/>
        <FIELD NAME="credentialid" TYPE="char" LENGTH="36" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="eventid" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="id de la entrega del webhook"/>
        <FIELD NAME="workspaceid" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="workspace_id del aviso"/>
        <FIELD NAME="duration" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Milisegundos que tardó la API"/>
        <FIELD NAME="detail" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="kindtime" UNIQUE="false" FIELDS="kind, timecreated"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="credentialid" UNIQUE="false" FIELDS="credentialid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
