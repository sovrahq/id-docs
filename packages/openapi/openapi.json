                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                "ejemplo6": {
                  "summary": "Zona de cobertura (calle y CP)",
                  "value": {
                    "dcql_query": {
                      "credentials": [
                        {
                          "id": "cobertura",
                          "format": "mso_mdoc",
                          "meta": {
                            "doctype_value": "io.sovra.0x5de0df12cce712ddaaa23feb359920ae4f3230d4.driving_licence_v2.1"
                          },
                          "claims": [
                            {
                              "path": [
                                "mx.gob.nl.icv.1",
                                "street"
                              ]
                            },
                            {
                              "path": [
                                "mx.gob.nl.icv.1",
                                "resident_postal_code"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                "ejemplo7": {
                  "summary": "Trámite que requiere CURP",
                  "value": {
                    "dcql_query": {
                      "credentials": [
                        {
                          "id": "tramite",
                          "format": "mso_mdoc",
                          "meta": {
                            "doctype_value": "io.sovra.0x5de0df12cce712ddaaa23feb359920ae4f3230d4.driving_licence_v2.1"
