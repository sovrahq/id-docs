<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="auth/sovra/db" VERSION="20261119" COMMENT="XMLDB file for Moodle auth/sovra"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="auth_sovra_session" COMMENT="Sesiones de ingreso con la SuperApp: una por verificación OID4VP. Sin documento, tipo ni DID del ciudadano">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="token" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Aleatorio; sólo lo conoce la sesión del navegador que pidió el ingreso"/>
        <FIELD NAME="verificationid" TYPE="char" LENGTH="36" NOTNULL="true" SEQUENCE="false" COMMENT="session_id de la verificación en Sovra"/>
        <FIELD NAME="status" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="pending, resolved, failed, expired"/>
        <FIELD NAME="result" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="ok, notfound, duplicate, issuernotallowed… o el error de Sovra"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="La cuenta resuelta, sólo si result = ok"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timeexpires" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Vencimiento de la verificación en Sovra"/>
        <FIELD NAME="timelastpoll" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Última consulta por GET a Sovra"/>
        <FIELD NAME="timecompleted" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="token" UNIQUE="true" FIELDS="token"/>
        <INDEX NAME="verificationid" UNIQUE="true" FIELDS="verificationid"/>
        <INDEX NAME="timeexpires" UNIQUE="false" FIELDS="timeexpires"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="auth_sovra_log" COMMENT="Registro de llamadas a la API, avisos del webhook e intentos de ingreso. Sin datos personales">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="kind" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="api, webhook o login"/>
        <FIELD NAME="action" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Método y ruta, tipo de evento, o de dónde salió el veredicto"/>
        <FIELD NAME="httpstatus" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="result" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="verificationid" TYPE="char" LENGTH="36" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="eventid" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="workspaceid" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="La cuenta que entró o se resolvió"/>
        <FIELD NAME="duration" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="detail" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="kindtime" UNIQUE="false" FIELDS="kind, timecreated"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
